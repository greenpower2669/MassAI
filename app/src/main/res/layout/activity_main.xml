<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MassAI"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Reconstruction 3D — v0.9 expérimental"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODE DE SEGMENTATION"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/segmentationModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeHumanRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Humain" />

            <RadioButton
                android:id="@+id/modeObjectRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Objet / humanoïde" />
        </RadioGroup>

        <TextView
            android:id="@+id/modeHelpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Humain : segmentation personne. Objet : segmentation générique du sujet pour tests."
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MESURES DE RÉFÉRENCE"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/heightInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Taille (cm)"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/weightInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Poids (kg)"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CAPTURE"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/captureProfileSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:contentDescription="Nombre de passages de capture" />

        <EditText
            android:id="@+id/manualLevelsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de passages (1 à 5)"
            android:importantForAutofill="no"
            android:inputType="number"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/cameraPreferenceSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:contentDescription="Choix de la caméra" />

        <TextView
            android:id="@+id/captureHelpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard : 2 passages. Caméra Auto par défaut."
            android:textSize="14sp" />

        <Button
            android:id="@+id/captureButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="FILMER LE SCAN 360°" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:text="IMPORTER UNE VIDÉO" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aucun scan chargé"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/turboReconstructionSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Reconstruction Turbo (désactiver pour comparer avec le moteur classique)"
            android:textSize="16sp" />

        <Button
            android:id="@+id/analysisButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="RECONSTRUIRE LE CORPS 3D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MODÈLE 3D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/modelPanel"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/model_panel"
            android:contentDescription="Zone interactive du modèle corporel 3D">

            <fr.massai.app.BodyModelView
                android:id="@+id/bodyModelView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Modèle corporel 3D rotatif" />

            <TextView
                android:id="@+id/modelStatusText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aucune reconstruction\nFilmez ou importez un tour complet du sujet."
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="18sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rawMeshButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="BRUT" />

            <Button
                android:id="@+id/repairedMeshButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="POINTS" />

            <Button
                android:id="@+id/meshButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="MESH" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/wireButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="FIL" />

            <Button
                android:id="@+id/holesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="CORRECTIONS" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveModelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="SAUVER .MASSAI" />

            <Button
                android:id="@+id/loadModelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OUVRIR" />

            <Button
                android:id="@+id/exportObjButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="EXPORT OBJ" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Glissez pour tourner, pincez pour zoomer. MESH = surface triangulée ; FIL = maillage filaire."
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="PIPELINE"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pipelineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="○ Extraction des vues\n○ Segmentation silhouette\n○ Visual hull 3D\n○ Réparation voxel\n○ Mise à l'échelle\n○ Volume et densité"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="RÉSULTATS"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/metricsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Volume : —\nDensité : —\nQualité technique : —"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/methodText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Méthode POC : visual hull multi-vues + nettoyage voxel + mesh triangulé. Les modèles peuvent être sauvegardés en .massai et exportés en OBJ. L’ultra grand-angle est utilisé seulement lorsqu’il est exposé par CameraX."
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
